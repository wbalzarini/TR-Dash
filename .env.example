# ─────────────────────────────────────────────────────────────────────────────
# Trident Island — configuration
#
# Copy to web/.env.local for local development. Every value below is optional:
# the defaults are the committed ones in web/lib/config.ts, and the app runs
# with no .env file at all. Add the same keys under Vercel → Settings →
# Environment Variables (Production + Preview) when you deploy.
#
# None of these are secrets today — no data source used by this app requires a
# key — but they are all read server-side only. Never prefix any of them with
# NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Location ────────────────────────────────────────────────────────────────
# The property. Drives the weather forecast and the nearest-river-station
# lookup. Decimal degrees; negative longitude is west.
TRIDENT_LATITUDE=44.35234
TRIDENT_LONGITUDE=-75.99996

# Display name shown under the header.
TRIDENT_PLACE_NAME=Thousand Islands, St. Lawrence River

# IANA timezone used to render dates and times. Leave blank to use whatever
# timezone Open-Meteo reports for the coordinates above.
TRIDENT_TIMEZONE=America/New_York

# ── Weather (Open-Meteo) ────────────────────────────────────────────────────
# Override only to point at a mirror or a mock. Open-Meteo's standard API needs
# no key.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# ── River (Canadian Hydrographic Service — IWLS) ────────────────────────────
# By default the app asks IWLS for its station list and picks the closest
# operating water-level station to TRIDENT_LATITUDE/TRIDENT_LONGITUDE.
#
# To pin a specific station, set ONE of these. RIVER_STATION_ID wins.
#   RIVER_STATION_ID   — the IWLS station UUID
#   RIVER_STATION_CODE — the CHS station code, e.g. 14400 for Brockville
# Browse stations at https://tides.gc.ca/en/stations
RIVER_STATION_ID=
RIVER_STATION_CODE=

# Override the IWLS base URL if the endpoint ever moves.
RIVER_API_BASE_URL=https://api-iwls.dfo-mpo.gc.ca/api/v1

# ── Border (Thousand Islands Bridge) ────────────────────────────────────────
# U.S. → Canada comes from the CBSA border wait time feed. The row is matched
# on this label (case-insensitive substring against the feed's location name).
BORDER_CBSA_LOCATION=Thousand Islands Bridge
BORDER_CBSA_URL=https://www.cbsa-asfc.gc.ca/bwt-taf/bwt-eng.csv

# Canada → U.S. comes from the U.S. CBP border wait time feed. 0708 is the
# Alexandria Bay, NY port of entry (Thousand Islands Bridge).
BORDER_CBP_PORT_NUMBER=0708
BORDER_CBP_CROSSING_NAME=Thousand Islands Bridge
BORDER_CBP_URL=https://bwt.cbp.gov/api/waittimes

# ── Cache TTLs (seconds) ────────────────────────────────────────────────────
# How long a successful response is served before the app refetches upstream.
CACHE_TTL_WEATHER=600
CACHE_TTL_RIVER=1200
CACHE_TTL_BORDER=600

# ── Future API keys ─────────────────────────────────────────────────────────
# Nothing needs these today. They exist so a keyed provider can be swapped in
# without touching application logic. Server-side only.
WEATHER_API_KEY=
RIVER_API_KEY=
BORDER_API_KEY=
